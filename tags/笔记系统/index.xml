      <description>&lt;h1 id=&#34;vscode-任务&#34;&gt;VSCode 任务&lt;/h1&gt;&#xA;&lt;p&gt;&lt;img src=&#34;../../../../img/VSCode%E7%AC%94%E8%AE%B0%E7%B3%BB%E7%BB%9F/%E5%88%9B%E5%BB%BA%E4%BB%BB%E5%8A%A1.jpg&#34; alt=&#34;创建任务&#34;&gt;&lt;/p&gt;&#xA;&lt;h1 id=&#34;vscode-快捷键&#34;&gt;VSCode 快捷键&lt;/h1&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;标题&lt;/th&gt;&#xA;          &lt;th&gt;快捷键&lt;/th&gt;&#xA;          &lt;th&gt;条件&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;在资源管理器中折叠文件夹&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;alt + ,&lt;/code&gt;  &lt;code&gt;alt + ,&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;del&gt;view == &amp;lsquo;workbench.explorer.fileView&amp;rsquo;&lt;/del&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;文件: 在资源管理器视图中显示活动文件&lt;/td&gt;&#xA;          &lt;td&gt;&lt;code&gt;alt + ,&lt;/code&gt;  &lt;code&gt;alt + ,&lt;/code&gt;&lt;/td&gt;&#xA;          &lt;td&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h1 id=&#34;设置&#34;&gt;设置&lt;/h1&gt;&#xA;&lt;h1 id=&#34;markdown&#34;&gt;markdown&lt;/h1&gt;&#xA;&lt;p&gt;添加 Front Matter&lt;/p&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;&#34;&gt;&lt;code class=&#34;language-yaml&#34; data-lang=&#34;yaml&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt; 1&lt;/span&gt;&lt;span&gt;---&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span style=&#34;white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f&#34;&gt; 2&lt;/span&gt;&lt;span&gt;&lt;span style=&#34;color:#f92672&#34;&gt;t