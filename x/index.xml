    <item>
      <title>暴雪安全令获取TOTP共享密钥及验证码</title>
      <link>http://localhost:1313/x/tools/blizzard/</link>
      <pubDate>Mon, 16 Dec 2024 19:44:35 +0000</pubDate>
      <guid>http://localhost:1313/x/tools/blizzard/</guid>
      <description>&lt;ul class=&#34;sub-menu &#34;&gt;&#xA;    &lt;li class=&#34;menu-item&#34;&gt;&lt;a href=&#34;http://localhost:1313/x/share/&#34;&gt;&lt;i class=&#34;fa fa-thumbs-up&#34;&gt;&amp;nbsp;&lt;/i&gt;分享&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li class=&#34;menu-item&#34;&gt;&lt;a href=&#34;http://localhost:1313/x/tools/&#34;&gt;&lt;i class=&#34;fa fa-wrench&#34;&gt;&amp;nbsp;&lt;/i&gt;工具&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li class=&#34;menu-item&#34;&gt;&lt;a href=&#34;http://localhost:1313/x/movies&#34;&gt;&lt;i class=&#34;fa fa-film&#34;&gt;&amp;nbsp;&lt;/i&gt;电影&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li class=&#34;menu-item&#34;&gt;&lt;a href=&#34;http://localhost:1313/x/books&#34;&gt;&lt;i class=&#34;fa fa-book&#34;&gt;&amp;nbsp;&lt;/i&gt;书籍&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li class=&#34;menu-item&#34;&gt;&lt;a href=&#34;http://localhost:1313/x/gallery/&#34;&gt;&lt;i class=&#34;fa fa-camera&#34;&gt;&amp;nbsp;&lt;/i&gt;相册&lt;/a&gt;&lt;/li&gt;&#xA;    &lt;li class=&#34;menu-item&#34;&gt;&lt;a href=&#34;http://localhost:1313/x/personal&#34;&gt;&lt;i class=&#34;fa fa-user&#34;&gt;&amp;nbsp;&lt;/i&gt;个人&lt;/a&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;&#xA;&lt;h2 id=&#34;在线计算&#34;&gt;在线计算&lt;/h2&gt;&#xA;&lt;script type=&#34;text/javascript&#34; src=&#34;http://localhost:1313/assets/js/blizzard/crypto-js.min.js&#34;&gt;&lt;/script&gt;&#xD;&#xA;&lt;div style=&#34;grid&#34;&gt;&#xD;&#xA;&lt;div style=&#34;display: flex; justify-content: left; align-items: center&#34;&gt;&#xD;&#xA;    &lt;label style=&#34;width: 6rem&#34; for=&#34;deviceSecret&#34;&gt;40位密钥&lt;/label&gt;&#xD;&#xA;    &lt;input id=&#34;deviceSecret&#34; type=&#34;text&#34; onkeydown=&#34;if(event.keyCode==13) {calc(event)}&#34; placeholder=&#34;暴雪40位密钥&#34;&#xD;&#xA;        style=&#34;border: 1px solid #d2d2d2; border-radius: 3px; width: 50%; margin-right: 1rem&#34;&gt;&#xD;&#xA;    &lt;button onclick=&#34;calc(event)&#34;&gt;确定&lt;/button&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;div style=&#34;display: flex; justify-content: left; align-items: center&#34;&gt;&#xD;&#xA;    &lt;label style=&#34;width: 6rem&#34; for=&#34;TOTP-Secret&#34;&gt;TOTP密钥&lt;/label&gt;&#xD;&#xA;    &lt;input id=&#34;TOTP-Secret&#34; type=&#34;text&#34; onkeydown=&#34;if(event.keyCode==13) {calc2(event)}&#34; placeholder=&#34;TOTP共享密钥&#34;&#xD;&#xA;        style=&#34;border: 1px solid #d2d2d2; border-radius: 3px; width: 50%; margin-right: 1rem&#34;&gt;&#xD;&#xA;    &lt;button onclick=&#34;calc2(event)&#34;&gt;确定&lt;/button&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;div style=&#34;display: flex; justify-content: left; align-items: center&#34;&gt;&#xD;&#xA;    &lt;label style=&#34;width: 6rem&#34; for=&#34;TOTP-preview&#34;&gt;验证码&lt;/label&gt;&#xD;&#xA;    &lt;input id=&#34;TOTP-preview&#34; type=&#34;text&#34; placeholder=&#34;验证码预览&#34;&#xD;&#xA;        style=&#34;border: 1px solid #d2d2d2; border-radius: 3px; width: 50%; margin-right: 1rem&#34; readonly&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;script&gt;&#xD;&#xA;    var calc = function(e) {&#xD;&#xA;        const deviceSecret = document.getElementById(&#39;deviceSecret&#39;).value.slice(0, 40);&#xD;&#xA;        const base32 = base32enc(deviceSecret);&#xD;&#xA;        document.getElementById(&#39;TOTP-Secret&#39;).value = base32;&#xD;&#xA;&#xD;&#xA;        const totp = calcTOTP(deviceSecret);&#xD;&#xA;        document.getElementById(&#39;TOTP-preview&#39;).value = totp;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    var calc2 = function(e) {&#xD;&#xA;        const base32 = document.getElementById(&#39;TOTP-Secret&#39;).value.slice(0, 32);&#xD;&#xA;        const deviceSecret = base32dec(base32);&#xD;&#xA;        document.getElementById(&#39;deviceSecret&#39;).value = deviceSecret;&#xD;&#xA;&#xD;&#xA;        const totp = calcTOTP(deviceSecret);&#xD;&#xA;        document.getElementById(&#39;TOTP-preview&#39;).value = totp;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // base32编码  40位密钥 -&gt; TOTP共享密钥&#xD;&#xA;    function base32enc(deviceSecret) {&#xD;&#xA;        const base32Chars = &#34;ABCDEFGHIJKLMNOPQRSTUVWXYZ234567&#34;;&#xD;&#xA;        let bin = &#39;&#39;;&#xD;&#xA;        for (let i = 0; i &lt; deviceSecret.length; i++) {&#xD;&#xA;            bin += parseInt(deviceSecret[i], 16).toString(2).padStart(4, &#39;0&#39;);&#xD;&#xA;        }&#xD;&#xA;        let base32 = &#34;&#34;;&#xD;&#xA;        for (let i = 0; i &lt; bin.length; i += 5) {&#xD;&#xA;            base32 += base32Chars[parseInt(bin.slice(i, i + 5), 2)];&#xD;&#xA;        }&#xD;&#xA;        return base32;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // base32解码  TOTP共享密钥 -&gt; 40位密钥&#xD;&#xA;    function base32dec(base32) {&#xD;&#xA;        const base32Chars = &#34;ABCDEFGHIJKLMNOPQRSTUVWXYZ234567&#34;;&#xD;&#xA;        let bin = &#39;&#39;;&#xD;&#xA;        for (let i = 0; i &lt; base32.length; i++) {&#xD;&#xA;            const val = base32Chars.indexOf(base32[i].toUpperCase());&#xD;&#xA;            if (val === -1) throw new Error(&#34;Invalid character in Base32 string&#34;);&#xD;&#xA;            bin += val.toString(2).padStart(5, &#34;0&#34;);&#xD;&#xA;        }&#xD;&#xA;        let secret = &#34;&#34;;&#xD;&#xA;        for (let i = 0; i &lt; bin.length; i += 4) {&#xD;&#xA;            secret += parseInt(bin.slice(i, i + 4), 2).toString(16);&#xD;&#xA;        }&#xD;&#xA;        return secret;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // TOTP共享密钥 -&gt; 8位验证码&#xD;&#xA;    function calcTOTP(deviceSecret) {&#xD;&#xA;        const bytes = new Uint8Array(deviceSecret.match(/.{2}/g).map(byte =&gt; parseInt(byte, 16)));&#xD;&#xA;        const key = CryptoJS.lib.WordArray.create(bytes);&#xD;&#xA;&#xD;&#xA;        const timeStep = 30;&#xD;&#xA;        const epoch = Math.floor(Date.now() / 1000);&#xD;&#xA;        const time = Math.floor(epoch / timeStep);&#xD;&#xA;        const message = CryptoJS.enc.Hex.parse(time.toString(16).padStart(16, &#34;0&#34;));&#xD;&#xA;&#xD;&#xA;        const hash = CryptoJS.HmacSHA1(message, key);&#xD;&#xA;        const hex = hash.toString(CryptoJS.enc.Hex);&#xD;&#xA;&#xD;&#xA;        const length = 8;&#xD;&#xA;        const offset = parseInt(hex.slice(-1), 16);&#xD;&#xA;        const totp = (parseInt(hex.slice(offset * 2, offset * 2 + 8), 16) &amp; 0x7fffffff) % Math.pow(10, length);&#xD;&#xA;        return totp.toString(10).padStart(8, &#34;0&#34;);&#xD;&#xA;    }&#xD;&#xA;&lt;/script&gt;&#xD;&#xA;&lt;/div&gt;&#xD;&#xA;&lt;hr&gt;&#xA;&lt;h2 id=&#34;简介&#34;&gt;简介&lt;/h2&gt;&#xA;&lt;p&gt;此处使用JavaScript代码进行转换，不涉及服务端操作（&lt;del&gt;舍不得花钱，博客还在用vercel托管部署，有代码基础的F12看一下就知道了&lt;/del&gt;）。想使用&lt;code&gt;Google Authenticator&lt;/code&gt;，&lt;code&gt;Microsoft Authenticator&lt;/code&gt;，&lt;code&gt;Authy&lt;/code&gt;，&lt;code&gt;KeepassXC&lt;/code&gt;，&lt;code&gt;1Password&lt;/code&gt;，&lt;code&gt;Bitwarden&lt;/code&gt;，&lt;code&gt;LastPass&lt;/code&gt;等2FA应用，管理暴雪的验证码，就需要将暴雪40位密钥转换为TOTP共享密钥，实际转换就是对其进行base32编码，然后在2FA应用中添加账号，设置加密算法为HMAC-SHA1，时间步长为30s，验证码长度为8位。&lt;/p&gt;</description>
    </item>
